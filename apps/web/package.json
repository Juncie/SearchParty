{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "pnpm --filter @searchparty/db db:generate",
    "db:migrate": "pnpm --filter @searchparty/db db:migrate",
    "db:push": "pnpm --filter @searchparty/db db:push",
    "db:pull": "pnpm --filter @searchparty/db db:pull",
    "db:studio": "pnpm --filter @searchparty/db db:studio"
  },
