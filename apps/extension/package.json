{
  "name": "search-party-extension",
  "description": "Search Party Browser Extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "serve:test-form": "wxt build && npx --yes serve@14 .output/chrome-mv3 -l 7242"
  },
  "dependencies": {
    "@searchparty/data": "workspace:*",
    "@searchparty/shared": "workspace:*",
    "@searchparty/utils": "workspace:*",
    "@tanstack/react-router": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  }
}